<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Scarlet" parent="Theme.Material3.DayNight.NoActionBar">

        <item name="android:statusBarColor">@color/negro</item>
        <item name="android:navigationBarColor">@color/negro</item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- COLOR PRINCIPAL DE SCARLET -->
        <item name="colorPrimary">@color/rojito</item>
        <item name="colorSecondary">@color/rojito</item>

        <item name="android:windowActionModeOverlay">true</item>

    </style>

    <style name="Theme.Scarlet" parent="Base.Theme.Scarlet" />

    <!-- TEXTO DEL MENU INFERIOR -->
    <style name="BottomNavigationText">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>