<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_card_dark"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ========================= -->
        <!-- TÍTULO + CERRAR -->
        <!-- ========================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTituloDialogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nuevo Proveedor"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Registra un nuevo distribuidor de licores."
                    android:textColor="#777777"
                    android:textSize="11sp" />

            </LinearLayout>

            <ImageView
                android:id="@+id/btnCerrarDialogo"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:padding="5dp"
                android:src="@drawable/ic_close"
                android:contentDescription="Cerrar" />

        </LinearLayout>

        <!-- ========================= -->
        <!-- RAZÓN SOCIAL / EMPRESA -->
        <!-- ========================= -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="Razón Social / Empresa"
            android:textColor="#CCCCCC"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/edtRazonSocial"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_form_field"
            android:hint="Ej. Distribuidor Copacabana"
            android:inputType="textCapWords"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:textSize="13sp" />

        <!-- ========================= -->
        <!-- RFC / NIT  +  CONDICIÓN PAGO -->
        <!-- ========================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="RFC / NIT"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/edtRfcNit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_form_field"
                    android:hint="COP-920412-K34"
                    android:inputType="textCapCharacters"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Condición Pago"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_form_field">

                    <Spinner
                        android:id="@+id/spinnerCondicionPago"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:paddingStart="10dp"
                        android:paddingEnd="30dp"
                        android:popupBackground="@drawable/bg_spinner_popup"
                        android:spinnerMode="dropdown" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_chevron_down" />

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ========================= -->
        <!-- MARCAS ASOCIADAS -->
        <!-- ========================= -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="Marcas Asociadas (separadas por coma)"
            android:textColor="#CCCCCC"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/edtMarcasAsociadas"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_form_field"
            android:hint="Ron Abuelo, Fernet Branca, Singani Casa Real"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:textSize="13sp" />

        <!-- ========================= -->
        <!-- CONTACTO EJECUTIVO / TELÉFONO -->
        <!-- ========================= -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="Contacto Ejecutivo / Teléfono"
            android:textColor="#CCCCCC"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edtContactoEjecutivo"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_form_field"
                android:hint="Carlos Mendoza"
                android:inputType="textCapWords"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edtTelefonoContacto"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_form_field"
                android:hint="+591 76543210"
                android:inputType="phone"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- ========================= -->
        <!-- BOTONES -->
        <!-- ========================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCancelarProveedor"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_cancelar_button"
                android:gravity="center"
                android:text="Cancelar"
                android:textColor="#ED2F09"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnGuardarProveedor"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_guardar_button"
                android:gravity="center"
                android:text="Guardar Proveedor"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>