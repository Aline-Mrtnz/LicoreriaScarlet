<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    tools:context=".MiCuenta">

    <!-- ========================= -->
    <!-- HEADER -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="82dp"
        android:background="#080808"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- VOLVER -->

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="3dp"
            android:src="@drawable/back_arrow"
            android:contentDescription="Volver" />

        <!-- TÍTULO -->

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="MI CUENTA"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ========================= -->
    <!-- CONTENIDO -->
    <!-- ========================= -->

    <ScrollView
        android:id="@+id/scrollCuenta"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:paddingBottom="30dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="25dp"
            android:paddingBottom="40dp">


            <!-- ========================= -->
            <!-- PERFIL -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="30dp">

                <ImageView
                    android:id="@+id/imgPerfilCuenta"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:background="@drawable/circle_background"
                    android:padding="10dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/scarlet"
                    android:contentDescription="Foto de perfil" />

                <TextView
                    android:id="@+id/txtNombreCuenta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Alex Santiago"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtRolCuenta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="● Administrador"
                    android:textColor="#FF2A00"
                    android:textSize="12sp" />

            </LinearLayout>


            <!-- ========================= -->
            <!-- INFORMACIÓN PERSONAL -->
            <!-- ========================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="INFORMACIÓN PERSONAL"
                android:textColor="#FF2A00"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginBottom="15dp" />


            <!-- NOMBRES -->

            <EditText
                android:id="@+id/edtNombres"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="#1A1A1A"
                android:hint="Nombres"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="14sp"
                android:inputType="textPersonName" />


            <!-- APELLIDOS -->

            <EditText
                android:id="@+id/edtApellidos"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="#1A1A1A"
                android:hint="Apellidos"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="14sp"
                android:inputType="textPersonName" />


            <!-- USUARIO -->

            <EditText
                android:id="@+id/edtUsuario"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="#1A1A1A"
                android:hint="Nombre de usuario"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="14sp"
                android:inputType="text" />


            <!-- CORREO -->

            <EditText
                android:id="@+id/edtCorreo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="#1A1A1A"
                android:hint="Correo electrónico"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="14sp"
                android:inputType="textEmailAddress" />


            <!-- TELÉFONO -->

            <EditText
                android:id="@+id/edtTelefono"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="25dp"
                android:background="#1A1A1A"
                android:hint="Teléfono"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="14sp"
                android:inputType="phone" />


            <!-- ========================= -->
            <!-- SEGURIDAD -->
            <!-- ========================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SEGURIDAD"
                android:textColor="#FF2A00"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginBottom="15dp" />


            <!-- CONTRASEÑA -->

            <EditText
                android:id="@+id/edtContrasena"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="25dp"
                android:background="#1A1A1A"
                android:hint="Nueva contraseña"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="14sp"
                android:inputType="textPassword" />


            <!-- ========================= -->
            <!-- GUARDAR -->
            <!-- ========================= -->

            <Button
                android:id="@+id/btnGuardarCambios"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#FF2A00"
                android:text="Guardar cambios"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>