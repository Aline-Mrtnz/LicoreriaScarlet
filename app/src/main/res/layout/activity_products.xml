<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080808"
    tools:context=".Productos">

    <!-- ========================= -->
    <!-- HEADER SCARLET -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="82dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#080808"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Menú -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#080808"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <!-- MENU -->

            <!--<TextView
            android:id="@+id/txtMenu"
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="☰"
            android:textColor="#FF2A00"
            android:textSize="19sp" />-->

            <ImageView
                android:id="@+id/imgMenu"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginLeft="5dp"
                android:layout_marginEnd="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/menu" />

            <!-- INFORMACION -->

            <LinearLayout
                android:layout_width="178dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="6dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SCARLET"
                    android:textColor="#FF2A00"
                    android:textSize="17sp"
                    android:textStyle="bold" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="BIENVENIDO"
                    android:textColor="#777777"
                    android:textSize="7sp" />


                <TextView
                    android:id="@+id/txtNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alex Santiago"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/txtRol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●  Administrador Senior"
                    android:textColor="#FF2A00"
                    android:textSize="7sp" />

            </LinearLayout>


            <!-- AVATAR -->

            <ImageView
                android:id="@+id/imgPerfil"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/circle_background"
                android:contentDescription="Perfil"
                android:scaleType="centerCrop"
                android:src="@drawable/scarlet" />


            <!-- NOTIFICACION -->

            <!--<TextView
            android:id="@+id/txtNotification"
            android:layout_width="25dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="♧"
            android:textColor="#FF2A00"
            android:textSize="17sp" />-->

            <!--CARRITO-->
            <ImageView
                android:id="@+id/imgCarrito"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginLeft="15dp"
                android:layout_marginEnd="4dp"
                android:layout_marginRight="5dp"
                android:scaleType="centerCrop"
                android:src="@drawable/carrito" />

            <ImageView
                android:id="@+id/imgNorificacion"
                android:layout_width="14dp"
                android:layout_height="18dp"
                android:layout_marginLeft="5dp"
                android:layout_marginEnd="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/notification" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtMenu"
            android:layout_width="35dp"
            android:layout_height="wrap_content"
            android:text="☰"
            android:textColor="#FF3B16"
            android:textSize="22sp"
            android:gravity="center" />

        <!-- Logo / nombre -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtScarlet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SCARLET"
                android:textColor="#FF725F"
                android:textStyle="bold"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/txtBienvenido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRODUCTOS"
                android:textColor="#777777"
                android:textSize="8sp" />

        </LinearLayout>

        <!-- Carrito -->
        <ImageView
            android:id="@+id/imgCarrito"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/carrito"
            android:contentDescription="Carrito"
            android:padding="5dp" />

        <!-- Notificación -->
        <ImageView
            android:id="@+id/imgNotificacion"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/notification"
            android:contentDescription="Notificaciones"
            android:padding="5dp" />

    </LinearLayout>


    <!-- ========================= -->
    <!-- CONTENIDO -->
    <!-- ========================= -->

    <ScrollView
        android:id="@+id/scrollProductos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="20dp">

            <!-- ========================= -->
            <!-- BUSCADOR -->
            <!-- ========================= -->

            <LinearLayout
                android:id="@+id/searchContainer"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_search"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="25dp"
                    android:layout_height="wrap_content"
                    android:text="⌕"
                    android:textColor="#777777"
                    android:textSize="22sp" />

                <EditText
                    android:id="@+id/edtBuscar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="Buscar spirits, wine, beer..."
                    android:textColorHint="#666666"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:paddingStart="5dp" />

            </LinearLayout>


            <!-- ========================= -->
            <!-- GRID DE PRODUCTOS -->
            <!-- ========================= -->

            <GridLayout
                android:id="@+id/gridProductos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="4"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false">

                <!-- ===================== -->
                <!-- MACALLAN -->
                <!-- ===================== -->

                <LinearLayout
                    android:id="@+id/cardMacallan"
                    android:layout_width="0dp"
                    android:layout_height="260dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:orientation="vertical"
                    android:padding="9dp"
                    android:background="@drawable/bg_product_card">

                    <ImageView
                        android:id="@+id/imgMacallan"
                        android:layout_width="match_parent"
                        android:layout_height="95dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/macallan18"
                        android:background="#050505"
                        android:contentDescription="Macallan 18" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Macallan 18\nSherry Oak"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="750ml · 43% ABV"
                        android:textColor="#888888"
                        android:textSize="9sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/precioMacallan"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="$399.99"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnAgregarMacallan"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_plus_button"
                            android:text="+"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:padding="0dp" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/btnDescripcionMacallan"
                        android:layout_width="match_parent"
                        android:layout_height="35dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_description_button"
                        android:text="Descripción"
                        android:textColor="#FF725F"
                        android:textSize="9sp"
                        android:minHeight="0dp"
                        android:minWidth="0dp" />

                </LinearLayout>


                <!-- ===================== -->
                <!-- DON JULIO -->
                <!-- ===================== -->

                <LinearLayout
                    android:id="@+id/cardDonJulio"
                    android:layout_width="0dp"
                    android:layout_height="260dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:orientation="vertical"
                    android:padding="9dp"
                    android:background="@drawable/bg_product_card">

                    <ImageView
                        android:id="@+id/imgDonJulio"
                        android:layout_width="match_parent"
                        android:layout_height="95dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/donjulio70"
                        android:background="#050505"
                        android:contentDescription="Don Julio 70" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Don Julio 70\nAñejo Claro"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="750ml · 40% ABV"
                        android:textColor="#888888"
                        android:textSize="9sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="$89.99"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnAgregarDonJulio"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_plus_button"
                            android:text="+"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:padding="0dp" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/btnDescripcionDonJulio"
                        android:layout_width="match_parent"
                        android:layout_height="35dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_description_button"
                        android:text="Descripción"
                        android:textColor="#FF725F"
                        android:textSize="9sp"
                        android:minHeight="0dp"
                        android:minWidth="0dp" />

                </LinearLayout>


                <!-- ===================== -->
                <!-- HENNESSY -->
                <!-- ===================== -->

                <LinearLayout
                    android:id="@+id/cardHennessy"
                    android:layout_width="0dp"
                    android:layout_height="260dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:orientation="vertical"
                    android:padding="9dp"
                    android:background="@drawable/bg_product_card">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="95dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/hennessyxo"
                        android:background="#050505"
                        android:contentDescription="Hennessy XO" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Hennessy X.O\nCognac"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="750ml · 40% ABV"
                        android:textColor="#888888"
                        android:textSize="9sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="$249.99"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnAgregarHennessy"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_plus_button"
                            android:text="+"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:padding="0dp" />

                    </LinearLayout>

                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="35dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_description_button"
                        android:text="Descripción"
                        android:textColor="#FF725F"
                        android:textSize="9sp"
                        android:minHeight="0dp"
                        android:minWidth="0dp" />

                </LinearLayout>


                <!-- ===================== -->
                <!-- GREY GOOSE -->
                <!-- ===================== -->

                <LinearLayout
                    android:id="@+id/cardGreyGoose"
                    android:layout_width="0dp"
                    android:layout_height="260dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:orientation="vertical"
                    android:padding="9dp"
                    android:background="@drawable/bg_product_card">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="95dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/greygoose"
                        android:background="#050505"
                        android:contentDescription="Grey Goose" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Grey Goose\nVodka"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="750ml · 40% ABV"
                        android:textColor="#888888"
                        android:textSize="9sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="$34.99"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnAgregarGreyGoose"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_plus_button"
                            android:text="+"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:padding="0dp" />

                    </LinearLayout>

                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="35dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_description_button"
                        android:text="Descripción"
                        android:textColor="#FF725F"
                        android:textSize="9sp"
                        android:minHeight="0dp"
                        android:minWidth="0dp" />

                </LinearLayout>


                <!-- ===================== -->
                <!-- CASAMIGOS -->
                <!-- ===================== -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="260dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:orientation="vertical"
                    android:padding="9dp"
                    android:background="@drawable/bg_product_card">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="95dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/casamigos"
                        android:background="#050505"
                        android:contentDescription="Casamigos" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Casamigos\nReposado"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="750ml · 40% ABV"
                        android:textColor="#888888"
                        android:textSize="9sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="$59.99"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="12sp" />

                        <Button
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_plus_button"
                            android:text="+"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:padding="0dp" />

                    </LinearLayout>

                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="35dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_description_button"
                        android:text="Descripción"
                        android:textColor="#FF725F"
                        android:textSize="9sp"
                        android:minHeight="0dp"
                        android:minWidth="0dp" />

                </LinearLayout>


                <!-- ===================== -->
                <!-- VEUVE CLICQUOT -->
                <!-- ===================== -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="260dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:orientation="vertical"
                    android:padding="9dp"
                    android:background="@drawable/bg_product_card">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="95dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/veuveclicquot"
                        android:background="#050505"
                        android:contentDescription="Veuve Clicquot" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Veuve Clicquot\nBrut"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="750ml · 12% ABV"
                        android:textColor="#888888"
                        android:textSize="9sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="$74.99"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="12sp" />

                        <Button
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_plus_button"
                            android:text="+"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:padding="0dp" />

                    </LinearLayout>

                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="35dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_description_button"
                        android:text="Descripción"
                        android:textColor="#FF725F"
                        android:textSize="9sp"
                        android:minHeight="0dp"
                        android:minWidth="0dp" />

                </LinearLayout>

            </GridLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>