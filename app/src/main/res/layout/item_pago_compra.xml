<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/txtFechaPago"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#999999"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/txtMetodoPago"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#999999"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/txtMontoPago"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#4CAF50"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtPorPago"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#999999"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/btnComprobantePago"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_btn_outline_grey"
        android:gravity="center"
        android:text="🧾"
        android:textSize="12sp"
        android:contentDescription="Comprobante de pago" />

</LinearLayout>