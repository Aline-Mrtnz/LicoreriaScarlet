<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#080808"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="Volver"
            android:src="@drawable/back_arrow" />

        <TextView
            android:id="@+id/txtTituloFormulario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nuevo Cajero"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Nombres" android:textColor="#AAAAAA" android:textSize="12sp" />
            <EditText android:id="@+id/edtNombresCajero" android:layout_width="match_parent" android:layout_height="48dp"
                android:background="@drawable/bg_stat_card" android:paddingStart="12dp" android:paddingEnd="12dp"
                android:textColor="#FFFFFF" android:textColorHint="#555555" android:textSize="14sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="Apellidos" android:textColor="#AAAAAA" android:textSize="12sp" />
            <EditText android:id="@+id/edtApellidosCajero" android:layout_width="match_parent" android:layout_height="48dp"
                android:background="@drawable/bg_stat_card" android:paddingStart="12dp" android:paddingEnd="12dp"
                android:textColor="#FFFFFF" android:textColorHint="#555555" android:textSize="14sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="CI" android:textColor="#AAAAAA" android:textSize="12sp" />
            <EditText android:id="@+id/edtCiCajero" android:layout_width="match_parent" android:layout_height="48dp"
                android:background="@drawable/bg_stat_card" android:paddingStart="12dp" android:paddingEnd="12dp"
                android:inputType="number" android:textColor="#FFFFFF" android:textColorHint="#555555" android:textSize="14sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="Teléfono" android:textColor="#AAAAAA" android:textSize="12sp" />
            <EditText android:id="@+id/edtTelefonoCajero" android:layout_width="match_parent" android:layout_height="48dp"
                android:background="@drawable/bg_stat_card" android:paddingStart="12dp" android:paddingEnd="12dp"
                android:inputType="phone" android:textColor="#FFFFFF" android:textColorHint="#555555" android:textSize="14sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="Usuario" android:textColor="#AAAAAA" android:textSize="12sp" />
            <EditText android:id="@+id/edtUsuarioCajero" android:layout_width="match_parent" android:layout_height="48dp"
                android:background="@drawable/bg_stat_card" android:paddingStart="12dp" android:paddingEnd="12dp"
                android:textColor="#FFFFFF" android:textColorHint="#555555" android:textSize="14sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="PIN (4 dígitos)" android:textColor="#AAAAAA" android:textSize="12sp" />
            <EditText android:id="@+id/edtPinCajero" android:layout_width="match_parent" android:layout_height="48dp"
                android:background="@drawable/bg_stat_card" android:paddingStart="12dp" android:paddingEnd="12dp"
                android:inputType="numberPassword" android:maxLength="4" android:textColor="#FFFFFF" android:textColorHint="#555555" android:textSize="14sp" />
            <TextView android:id="@+id/txtAyudaPin" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="El Cajero usará este PIN para iniciar sesión"
                android:textColor="#666666" android:textSize="11sp" />

            <TextView android:id="@+id/btnGuardarCajero" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:background="@drawable/bg_filter_selected" android:gravity="center"
                android:padding="14dp" android:text="Guardar" android:textColor="#FFFFFF" android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>