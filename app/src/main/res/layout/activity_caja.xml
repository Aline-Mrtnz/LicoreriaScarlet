<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#080808"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="Volver"
            android:src="@drawable/back_arrow" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Caja"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutCajaCerrada"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_stat_card"
            android:padding="16dp"
            android:text="🔴 Caja cerrada. Abre tu turno antes de registrar ventas."
            android:textColor="#FF5252"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Monto de apertura (Bs)"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/edtMontoApertura"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_stat_card"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="numberDecimal"
            android:hint="0.00"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555" />

        <TextView
            android:id="@+id/btnAbrirCaja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_filter_selected"
            android:gravity="center"
            android:padding="14dp"
            android:text="Abrir caja"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutCajaAbierta"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_stat_card"
            android:padding="16dp"
            android:text="🟢 Caja abierta"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtInfoTurno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Efectivo contado al cierre (Bs)"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/edtMontoContado"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_stat_card"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="numberDecimal"
            android:hint="0.00"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555" />

        <EditText
            android:id="@+id/edtObservacionCierre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_stat_card"
            android:padding="12dp"
            android:hint="Observaciones (opcional)"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:minLines="2" />

        <TextView
            android:id="@+id/btnCerrarCaja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_filter_selected"
            android:gravity="center"
            android:padding="14dp"
            android:text="Cerrar caja (arqueo)"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>