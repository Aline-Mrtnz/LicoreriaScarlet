<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="340dp"
    android:layout_height="520dp"
    android:background="@drawable/bg_dialog_card_dark"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- TÍTULO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Historial de Movimientos"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtHistorialProducto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Abuelo 12 años"
                android:textColor="#777777"
                android:textSize="11sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btnCerrarHistorial"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Cerrar"
            android:padding="2dp"
            android:src="@drawable/ic_close" />

    </LinearLayout>

    <!-- FILTRO TIPO -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Filtrar tipo"
        android:textColor="#CCCCCC"
        android:textSize="11sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_form_field">

        <Spinner
            android:id="@+id/spinnerTipoMovimiento"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:paddingStart="14dp"
            android:paddingEnd="36dp"
            android:popupBackground="@drawable/bg_spinner_popup"
            android:spinnerMode="dropdown" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="14dp"
            android:src="@drawable/ic_chevron_down" />

    </FrameLayout>

    <!-- LISTA -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMovimientos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:scrollbars="none"
        tools:listitem="@layout/item_movimiento"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:id="@+id/txtHistorialVacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:gravity="center"
        android:text="Sin movimientos registrados para este producto."
        android:textColor="#666666"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- CERRAR -->
    <TextView
        android:id="@+id/btnCerrarHistorialFooter"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_btn_outline_grey"
        android:gravity="center"
        android:text="Cerrar"
        android:textColor="#CCCCCC"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>