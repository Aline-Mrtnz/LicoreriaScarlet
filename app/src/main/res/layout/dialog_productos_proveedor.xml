<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_card_dark"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ========================= -->
        <!-- TÍTULO + CERRAR -->
        <!-- ========================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTituloProductosDialogo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Productos de Distribuidor Copacabana"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnCerrarProductosDialogo"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:padding="5dp"
                android:src="@drawable/ic_close"
                android:contentDescription="Cerrar" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Vincula aquí qué productos vende este proveedor y a qué precio te los pacta — ese precio se usa para autocompletar el formulario cuando armas una compra."
            android:textColor="#777777"
            android:textSize="11sp" />

        <!-- ========================= -->
        <!-- SELECCIONAR PRODUCTO -->
        <!-- ========================= -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_form_field">

            <Spinner
                android:id="@+id/spinnerProducto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:paddingStart="10dp"
                android:paddingEnd="30dp"
                android:popupBackground="@drawable/bg_spinner_popup"
                android:spinnerMode="dropdown" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_chevron_down" />

        </FrameLayout>

        <EditText
            android:id="@+id/edtPrecioPactado"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_form_field"
            android:hint="Precio pactado (Bs)"
            android:inputType="numberDecimal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnAgregarProducto"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_guardar_button"
            android:gravity="center"
            android:text="+ AGREGAR"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- ========================= -->
        <!-- ENCABEZADO TABLA -->
        <!-- ========================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PRODUCTO"
                android:textColor="#777777"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="UNIDAD"
                android:textColor="#777777"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="PRECIO"
                android:textColor="#777777"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="ACCIONES"
                android:textColor="#777777"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ========================= -->
        <!-- FILAS DE PRODUCTOS (se llenan por código) -->
        <!-- ========================= -->
        <LinearLayout
            android:id="@+id/llFilasProductos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvSinProductosVinculados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:text="Aún no hay productos vinculados."
            android:textColor="#555555"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- ========================= -->
        <!-- PIE -->
        <!-- ========================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvContadorProductosVinculados"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0 productos vinculados"
                android:textColor="#777777"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnCerrarProductos"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_btn_outline_grey"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Cerrar"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>